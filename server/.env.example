GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
FATSECRET_CLIENT_ID=your_fatsecret_client_id_here
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret_here
PORT=5000

# Firebase Admin SDK — provide EITHER the JSON string or a file path
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Secret header value required for the POST /admin/cleanup-inactive-users endpoint
ADMIN_SECRET=your_admin_secret_here
